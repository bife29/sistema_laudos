# ============================================================
# .env — Arquivo de configuração do sistema
# COPIE este arquivo para .env e preencha os valores
# ============================================================

# ── Aplicação ───────────────────────────────────────────────
APP_NAME=Sistema de Laudos EEG
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
SECRET_KEY=TROQUE-POR-UMA-CHAVE-SECRETA-FORTE-AQUI

# ── Banco de Dados ──────────────────────────────────────────
# SQLite (padrão para desenvolvimento — sem instalar nada)
DATABASE_URL=sqlite+aiosqlite:///./data/eeg_laudos.db

# PostgreSQL (para produção — descomente e preencha)
# DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/eeg_laudos

# ── Armazenamento de Arquivos ───────────────────────────────
# local (padrão) | s3 | minio
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/uploads

# S3 / MinIO (descomente se usar)
# STORAGE_S3_BUCKET=eeg-laudos
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT_URL=  # Para MinIO: http://localhost:9000

# ── LLM (Inteligência Artificial para gerar laudos) ────────
# anthropic | openai | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=COLOQUE-SUA-API-KEY-AQUI
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# OpenAI (alternativa — descomente se usar)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=sk-...

# Ollama (local/gratuito — descomente se usar)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3
# LLM_BASE_URL=http://localhost:11434

# ── Redis (opcional — para cache e filas) ───────────────────
# Deixe vazio para desabilitar
REDIS_URL=

# ── JWT (Autenticação) ─────────────────────────────────────
JWT_SECRET_KEY=TROQUE-POR-OUTRA-CHAVE-SECRETA-AQUI
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (Origens permitidas) ──────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Laudo ───────────────────────────────────────────────────
LAUDO_DISCLAIMER=Laudo gerado com auxílio de inteligência artificial. A validação e responsabilidade clínica são do médico assinante.
